{
  "name": "@mollerse/midi-control",
  "version": "3.0.0",
  "description": "Functionality for binding a tweakpane pane to a MIDI Device",
  "author": "Stian Møllersen <stian.moellersen@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mollerse/midi-control.git"
  },
  "bugs": {
    "url": "https://github.com/mollerse/midi-control/issues"
  },
  "homepage": "https://github.com/mollerse/midi-control#readme",
  "keywords": [
    "tweakpane",
    "midi",
    "creative"
  ],
  "type": "module",
  "files": [
    "src/*",
    "types/*"
  ],
  "exports": {
    ".": {
      "types": "./types/types.d.ts",
      "node": "./src/index-node.js",
      "browser": "./src/index.js",
      "default": "./src/index.js"
    },
    "./devices/launch-control.js": {
      "types": "./types/devices/launch-control.d.ts",
      "default": "./src/devices/launch-control.js"
    },
    "./devices/midi-mix.js": {
      "types": "./types/devices/midi-mix.d.ts",
      "default": "./src/devices/midi-mix.js"
    },
    "./devices/nanokontrol.js": {
      "types": "./types/devices/nanokontrol.d.ts",
      "default": "./src/devices/nanokontrol.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:web": "vite ./test/web",
    "test:node": "node ./test/node/test.js",
    "lint": "eslint .",
    "format": "prettier . -w",
    "typecheck": "tsc -p ./jsconfig.json --noEmit"
  },
  "dependencies": {
    "tweakpane": "^4.0.4"
  },
  "optionalDependencies": {
    "midi": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tweakpane/core": "^2.0.4",
    "@types/midi": "^2.0.4",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "prettier": {
    "printWidth": 100
  },
  "engines": {
    "node": ">= 22.0"
  },
  "volta": {
    "node": "24.12.0"
  }
}
